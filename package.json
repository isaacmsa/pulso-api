{
  "name": "pulso-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:backup": "vitest run --project backup",
    "spike:analyze": "tsx scripts/spike/analyze.ts",
    "fixtures:shift": "tsx scripts/fixtures/shift-export.ts",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "cf-typegen": "wrangler types --env-file .dev.vars.example"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
