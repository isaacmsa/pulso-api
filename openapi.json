{
  "openapi": "3.1.0",
  "info": {
    "title": "Pulso API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token del dispositivo, el que devuelve `POST /v1/devices`."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "validation_failed",
                  "invalid_token",
                  "not_found",
                  "home_exists",
                  "rate_limited",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "RegisterDeviceResponse": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "minLength": 87,
            "maxLength": 87
          }
        },
        "required": [
          "deviceId",
          "token"
        ]
      },
      "RegisterDeviceRequest": {
        "type": "object",
        "properties": {
          "appVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "example": "1.0.0"
          }
        },
        "required": [
          "appVersion"
        ]
      },
      "UpdateDeviceRequest": {
        "type": "object",
        "properties": {
          "pushToken": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "appVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "example": "1.0.0"
          }
        }
      },
      "CreateHomeResponse": {
        "type": "object",
        "properties": {
          "homeId": {
            "type": "string",
            "format": "uuid"
          },
          "shareCode": {
            "type": "string",
            "pattern": "^[2-9A-HJKMNP-Z]{8}$"
          }
        },
        "required": [
          "homeId",
          "shareCode"
        ]
      },
      "CreateHomeRequest": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "default": "Casa",
            "example": "Casa de mamá"
          }
        }
      },
      "UpdateHomeRequest": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "Casa de mamá"
          },
          "mode": {
            "type": "string",
            "enum": [
              "base",
              "ups"
            ]
          }
        }
      },
      "HomeStatus": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "con_luz",
              "sin_luz",
              "sin_noticias"
            ]
          },
          "since": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "alias": {
            "type": "string"
          },
          "openOutageStart": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "state",
          "since",
          "alias",
          "openOutageStart"
        ]
      },
      "ShareCode": {
        "type": "object",
        "properties": {
          "shareCode": {
            "type": "string",
            "pattern": "^[2-9A-HJKMNP-Z]{8}$"
          }
        },
        "required": [
          "shareCode"
        ]
      },
      "FollowItem": {
        "type": "object",
        "properties": {
          "homeId": {
            "type": "string",
            "format": "uuid"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "Casa de mamá",
            "description": "El alias que le puse yo, no el del dueño"
          },
          "status": {
            "$ref": "#/components/schemas/HomeStatus"
          }
        },
        "required": [
          "homeId",
          "alias",
          "status"
        ]
      },
      "FollowRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[2-9A-HJKMNP-Z]{8}$",
            "description": "Código de la casa, 8 caracteres. Las minúsculas se aceptan",
            "example": "K7M2QX9P"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "Casa de mamá",
            "description": "Cómo llamo yo a esa casa"
          }
        },
        "required": [
          "code",
          "alias"
        ]
      },
      "FollowList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FollowItem"
            },
            "description": "Ordenadas por alias"
          }
        },
        "required": [
          "items"
        ]
      },
      "OutageHistory": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutageItem"
            },
            "description": "Cortes que se solapan con el rango, el más reciente primero"
          },
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportItem"
            },
            "description": "Reportes del rango, el más reciente primero, como máximo los 1000 más recientes. Llegan hasta donde llega la retención (30 días)"
          },
          "totalMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Suma de los cortes `cerrado` y `abierto` recortados al rango; el abierto cuenta hasta ahora"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DaySummary"
            },
            "description": "Todos los días del rango, también los que suman 0"
          }
        },
        "required": [
          "items",
          "reports",
          "totalMs",
          "days"
        ]
      },
      "OutageItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "start": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "end": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "null: sigue abierto"
          },
          "status": {
            "type": "string",
            "enum": [
              "abierto",
              "cerrado",
              "descartado",
              "sin_datos"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "manual"
            ]
          },
          "confirmed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null: sin respuesta"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "status",
          "confidence",
          "confirmed"
        ]
      },
      "ReportItem": {
        "type": "object",
        "properties": {
          "at": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "value": {
            "type": "string",
            "enum": [
              "hay_luz",
              "fluctuando",
              "sin_luz"
            ]
          }
        },
        "required": [
          "at",
          "value"
        ]
      },
      "DaySummary": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Día local de Caracas (UTC−4)",
            "example": "2026-10-19"
          },
          "ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "ms"
        ]
      },
      "IngestEventsResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "duplicated": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/HomeStatus"
          }
        },
        "required": [
          "accepted",
          "duplicated",
          "status"
        ]
      },
      "EventBatch": {
        "type": "object",
        "properties": {
          "sentAt": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "diagnostics": {
            "$ref": "#/components/schemas/Diagnostics"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceEvent"
            },
            "maxItems": 200
          }
        },
        "required": [
          "sentAt",
          "diagnostics",
          "events"
        ]
      },
      "Diagnostics": {
        "type": "object",
        "properties": {
          "appVersion": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "sdkInt": {
            "type": "integer"
          },
          "standbyBucket": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ignoringBatteryOptimizations": {
            "type": "boolean"
          },
          "pendingEvents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "appVersion",
          "manufacturer",
          "model",
          "sdkInt",
          "standbyBucket",
          "ignoringBatteryOptimizations",
          "pendingEvents"
        ]
      },
      "DeviceEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SnapshotEvent"
          },
          {
            "$ref": "#/components/schemas/ReportEvent"
          },
          {
            "$ref": "#/components/schemas/ConfirmationEvent"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "snapshot": "#/components/schemas/SnapshotEvent",
            "report": "#/components/schemas/ReportEvent",
            "confirmation": "#/components/schemas/ConfirmationEvent"
          }
        }
      },
      "SnapshotEvent": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "snapshot"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "network_callback",
              "heartbeat",
              "charging_job",
              "power_receiver",
              "transition_check",
              "app_open",
              "boot"
            ]
          },
          "plugged": {
            "type": "boolean"
          },
          "onWifi": {
            "type": "boolean"
          },
          "homeWifi": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "internet": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "interactive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "batteryPct": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "kind",
          "id",
          "at",
          "source",
          "plugged",
          "onWifi",
          "homeWifi",
          "internet",
          "interactive",
          "batteryPct"
        ]
      },
      "ReportEvent": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "report"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "value": {
            "type": "string",
            "enum": [
              "hay_luz",
              "fluctuando",
              "sin_luz"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "at",
          "value"
        ]
      },
      "ConfirmationEvent": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "confirmation"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "outageStart": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "answer": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "id",
          "at",
          "outageStart",
          "answer"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "monitoreo"
        ],
        "summary": "La API y la base responden",
        "responses": {
          "200": {
            "description": "La base respondió a un `SELECT 1`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "429": {
            "description": "Más de 60 peticiones por minuto desde esta IP",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`: la base no respondió",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices": {
      "post": {
        "operationId": "registerDevice",
        "tags": [
          "dispositivos"
        ],
        "summary": "Registrar el teléfono al primer arranque",
        "description": "Devuelve el token una sola vez: la API solo guarda su SHA-256.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dispositivo registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterDeviceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Más de 5 registros por minuto desde esta IP",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`: algo falló de nuestro lado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices/me": {
      "patch": {
        "operationId": "updateDevice",
        "tags": [
          "dispositivos"
        ],
        "summary": "Guardar el push token y la versión de la app",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Guardado"
          },
          "400": {
            "description": "Cuerpo inválido o sin campos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`: algo falló de nuestro lado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteDevice",
        "tags": [
          "dispositivos"
        ],
        "summary": "Borrar el dispositivo, su casa y todo lo asociado",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Borrado, con su casa, eventos, cortes y seguidores"
          },
          "401": {
            "description": "Token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`: algo falló de nuestro lado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/homes": {
      "post": {
        "operationId": "createHome",
        "tags": [
          "casas"
        ],
        "summary": "Este teléfono vigila mi casa: crea la casa del dispositivo",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHomeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Casa creada y asignada al dispositivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateHomeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`home_exists`: el dispositivo ya vigila una casa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`: algo falló de nuestro lado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/homes/me": {
      "patch": {
        "operationId": "updateHome",
        "tags": [
          "casas"
        ],
        "summary": "Cambiar el alias o el modo (`base` o `ups`) de mi casa",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateHomeRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Guardado"
          },
          "400": {
            "description": "Cuerpo inválido o sin campos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "El dispositivo no tiene casa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error`: algo falló de nuestro lado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
