      "get": {
        "operationId": "getOutages",
        "tags": [
          "casas"
        ],
        "summary": "Historial de cortes de mi casa en un rango, con el resumen por día",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 4102444800000,
              "description": "Inicio del rango, epoch ms (incluido)",
              "example": 1760000000000
            },
            "required": true,
            "description": "Inicio del rango, epoch ms (incluido)",
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 4102444800000,
              "description": "Fin del rango, epoch ms (excluido). Debe ser mayor que `from`, con un máximo de 92 días",
              "example": 1760604800000
            },
            "required": true,
            "description": "Fin del rango, epoch ms (excluido). Debe ser mayor que `from`, con un máximo de 92 días",
            "name": "to",
            "in": "query"
