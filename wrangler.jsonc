// Configuración del Worker. Nada secreto aquí (regla 12): la cadena de conexión de cada entorno
// vive en su Hyperdrive, y los secretos van con `wrangler secret put --env <entorno>`.
// `hyperdrive`, `vars` y `ratelimits` no se heredan: cada entorno repite los suyos.
// Producción se agrega en la fase 2 (A-018) y los crons en las fases 3 y 4 (A-019).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulso-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Nivel superior: solo para `wrangler dev` contra el PostgreSQL de `compose.dev.yaml`.
  // La cadena es del contenedor de desarrollo, no secreta. El `id` no se usa en local.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local",
      "localConnectionString": "postgres://pulso_api:pulso_dev@localhost:54322/pulso_dev"
    }
  ],
  "vars": { "ENVIRONMENT": "local", "EXPOSE_DOCS": "true" },
  // El binding solo admite periodos de 10 o 60 s (A-014).
  "ratelimits": [
    {
      "name": "RATE_LIMIT_REGISTER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_EVENTS",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    { "name": "RATE_LIMIT_API", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "RATE_LIMIT_PUBLIC",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "env": {
    "staging": {
      "name": "pulso-api-staging",
      // Hyperdrive con la conexión directa y la caché desactivada (A-015). Isaac pasa el `id`.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4c73e19917d346beb6582b5d254507c6" }],
      "vars": { "ENVIRONMENT": "staging", "EXPOSE_DOCS": "true" },
      "ratelimits": [
        {
          "name": "RATE_LIMIT_REGISTER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_EVENTS",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_API",
          "namespace_id": "1003",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_PUBLIC",
          "namespace_id": "1004",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  }
}
