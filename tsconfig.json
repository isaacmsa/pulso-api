{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "test", "vitest.config.ts"],
  // lo compila tsconfig.worker.json, con los tipos de Workers
  "exclude": ["src/worker-env.check.ts"]
}
